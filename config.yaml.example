ai:
  gemini_api_key: YOUR_GEMINI_API_KEY_HERE
  openai_api_key: YOUR_OPENAI_API_KEY_HERE
ai_tags:
  language: fr
  max_tags: 10
  provider: gemini  # or openai
backgrounds:
  strategies:
  - same_for_all
  - theme_based
  - random_each
  - custom_each
general:
  default_publish_time: 09:00
  max_daily_uploads: 5
  max_weekly_uploads: 20
  timezone: Europe/Paris
scheduling:
  preferred_days:
  - monday
  - wednesday
  - friday
  preferred_hours:
  - 09:00
  - '17:00'
  - '20:00'
  spacing_hours: 48
youtube:
  auto_publish: false
  default_category: '24'
  default_privacy: private
