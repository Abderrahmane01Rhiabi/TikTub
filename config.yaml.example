ai:
  gemini_api_key: YOUR_GEMINI_API_KEY_HERE
  openai_api_key: YOUR_OPENAI_API_KEY_HERE
ai_tags:
  language: fr
  max_tags: 10
  provider: gemini  # or openai
backgrounds:
  strategies:
  - same_for_all
  - theme_based
  - random_each
  - custom_each
general:
  default_publish_time: 09:00
  max_daily_uploads: 5
  max_weekly_uploads: 20
  timezone: Europe/Paris
scheduling:
  preferred_days:
  - monday
  - wednesday
  - friday
  preferred_hours:
  - 09:00
  - '17:00'
  - '20:00'
  spacing_hours: 48
youtube:
  auto_publish: false
  default_category: '24'
  default_privacy: private
  # Quota YouTube par projet Google Cloud (partagé par les chaînes dont le
  # credentials.json vient du même projet), réinitialisé à minuit heure du
  # Pacifique. Sert uniquement à l'ESTIMATION affichée avant publication ;
  # seul un vrai refus "quotaExceeded" de YouTube bloque les uploads.
  # Coût d'un upload : ~1600 unités historiquement, ~100 annoncé depuis fin
  # 2025 — vérifie dans Google Cloud Console → API YouTube Data → Quotas.
  quota:
    upload_cost: 100
    daily_units: 10000
