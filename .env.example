# Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# Gemini AI API Key — free tier (Get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key — used by the generative pipeline (script -> voice) for
# channels with "generation_mode": true (Get from: https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Pixabay API Key — drone/nature shots for the "Montage auto" (free, commercial
# use allowed). Get from: https://pixabay.com/api/docs/ (logged in, the key is on the page)
PIXABAY_API_KEY=your_pixabay_api_key_here
