# TikTub Configuration
# ===================

# OpenAI API Configuration
# Set to 'false' to disable OpenAI API and use only local AI
USE_OPENAI_API=true

# Force local AI only (overrides USE_OPENAI_API)
# Set to 'true' to completely disable all OpenAI features
FORCE_LOCAL_AI_ONLY=false

# OpenAI API Key (leave as is)
OPENAI_API_KEY=your_openai_api_key_here

# YouTube API Configuration
# Add your other environment variables below as needed
